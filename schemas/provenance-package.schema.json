{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-tools.xufentu.com/schemas/provenance-package.schema.json",
  "title": "Provenance Tool Package Schema",
  "type": "object",
  "required": [
    "metadata_schema_version",
    "record_id",
    "generated_by",
    "generated_at_utc",
    "title",
    "files",
    "responsibility_boundary"
  ],
  "properties": {
    "metadata_schema_version": {
      "type": "string"
    },
    "record_id": {
      "type": "string",
      "minLength": 8
    },
    "generated_by": {
      "type": "object",
      "required": [
        "name",
        "version",
        "original_researcher"
      ],
      "properties": {
        "name": {
          "const": "Provenance Tool"
        },
        "version": {
          "type": "string"
        },
        "original_researcher": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relative_path",
          "size_bytes",
          "sha256"
        ]
      }
    },
    "responsibility_boundary": {
      "type": "object"
    }
  },
  "description": "Minimum public schema for packages generated by compatible provenance tools."
}
